# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase -> Project Settings -> API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SEGRETA - solo server, mai con prefisso NEXT_PUBLIC_, mai su GitHub.
# Serve per il registro accessi (IP / VPN) e il controllo dei nomi all'iscrizione.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Email di benvenuto (SMTP). Esempio con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=indirizzo gmail, SMTP_PASS=password per le app (non la password normale).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Facoltativa: mittente se diverso da SMTP_USER (il nome visualizzato e' sempre "Westeros GDR")
MAIL_FROM=

# Facoltativa: chiave gratuita di https://proxycheck.io per il controllo VPN
# (senza chiave ~100 verifiche al giorno, con chiave gratuita 1000)
PROXYCHECK_API_KEY=
